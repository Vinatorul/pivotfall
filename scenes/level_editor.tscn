[node name="HelpText" type="RichTextLabel" parent="EditorView/PanelHost/HelpPanel"]
layout_mode = 0
offset_left = 20.0
offset_top = 60.0
offset_right = 700.0
offset_bottom = 404.0
scroll_active = true
text = "ЛКМ — выбрать или поставить объект. Потяните мышью, чтобы задать размер пола или передвинуть объект.\n\nQ — выбор. Клавиши инструментов указаны в палитре слева. Стрелки — сдвиг по сетке; Shift + стрелки — на 1 px. Delete — удалить, Cmd/Ctrl+D — копия.\n\nCmd/Ctrl+Z — отменить, Cmd/Ctrl+Shift+Z или Cmd/Ctrl+Y — повторить. Cmd/Ctrl+S — сохранить, Cmd/Ctrl+N — новый, Cmd/Ctrl+O — открыть.\n\nСвойства открываются кнопкой под палитрой после выбора объекта. Enter или выход из поля применяет значение. При вводе текста клавиши инструментов не срабатывают.\n\nЧтобы связать шарнир или плиту, откройте свойства и выберите цель из списка либо нажмите кнопку выбора на поле. Шарнир управляет платформой, воротами, катапультой или лифтом. Плита удерживает платформу или ворота, пока на ней стоит игрок или враг. Одну цель нельзя одновременно связать с плитой и шарниром.\n\nF5 — проверить уровень в игре. Esc вернёт прежний черновик, выделение и Undo/Redo. Тест не записывает прогресс кампании.\n\nEsc сначала закрывает панель или отменяет перетаскивание / связь, затем сбрасывает инструмент, выделение и предлагает выход.\n\nСтрока внизу показывает ошибки и предупреждения. Нажмите её для подробностей. Ошибки блокируют сохранение, тест и экспорт; предупреждения не мешают проверить уровень в игре."

